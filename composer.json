{
    "name": "postcode-nl/api-magento2-module",
    "version": "4.2.1",
    "description": "Postcode.eu Address Validation module for Magento 2. Adds autocompletion for addresses in multiple countries using official postal data.",
    "require": {
      "php": "^7.4 || ^8.0",
      "magento/module-checkout": "~100.4"
    },
    "type": "magento2-module",
    "license": "BSD-2-Clause",
    "homepage": "https://www.postcode.eu",
    "autoload": {
        "files": [ "registration.php" ],
        "psr-4": {
            "PostcodeEu\\AddressValidation\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
